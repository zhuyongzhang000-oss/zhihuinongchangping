# systemd 服务示例：cp deploy/agri-trace.service /etc/systemd/system/ && systemctl enable --now agri-trace
[Unit]
Description=Agri Trace Backend
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/agri-trace
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
Environment=DB_NAME=agri_trace
Environment=DB_USER=root
Environment=DB_PASSWORD=root
Environment=JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/agri-trace/agri-trace.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
